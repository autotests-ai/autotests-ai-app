# Public GitHub OAuth App id for dest user. Never a PAT.
# Client secret stays on POST /api/oauth/github, not in VITE_.
VITE_GITHUB_OAUTH_CLIENT_ID=

# Dest cloud school IdP. Empty → Home button hidden. Never a token or VITE_ secret.
# Client secret stays on POST /api/oauth/idp.
# VITE_IDP_AUTHORIZE_URL=
# VITE_IDP_CLIENT_ID=
