# Stage compose overrides (Box3 second project).
# docker compose --project-name autotests-ai-app-stage --env-file deploy/stage.env …
# yaml `name:` is autotests-ai-app — without --project-name this file would steal prod.
# Gateway bind stays 127.0.0.1 (see docker-compose.yml). Do not occupy matrix 8800–8851 / 9800–9821.

GATEWAY_PORT=18081
