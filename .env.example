# Dest user push: unzip assemble zip via the host stand.
# From the monorepo: python scripts/stands/ensure.py assemble-zip
# Empty → dest user push 503. Do not set host-gateway / this URL on prod.
ASSEMBLE_URL=

# Dest cloud IdP (not GitHub). Empty → Home button hidden. Do not put a secret here.
