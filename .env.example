# Dest zip / dest user push / dest cloud tree: unzip assemble zip via the stand.
# Local: python scripts/stands/ensure.py assemble-zip → host.docker.internal:3032 (base compose).
# Box3: systemd assemble-zip on docker0. Not host-gateway, not 0.0.0.0, not a public port.
# Host /opt/autotests-ai-app/.env 600 — not git, not VITE_, never cat.
ASSEMBLE_URL=http://172.17.0.1:3032

# Home import URL/zip (adopt). Not dest zip. Not PAT. Local: ensure.py adopt → :3033.
# ADOPT_URL=http://172.17.0.1:3033

# Dest cloud IdP (not GitHub). Empty VITE_ → Home button hidden. Do not put a secret here.
# Client autotests-ai in realm qaguru (auth-qa-guru-home). Redirect /oauth/idp/callback.
# CD frontend image: GHA repository vars VITE_IDP_* → Docker ARG (not this file).
# Box3 host /opt/autotests-ai-app/.env chmod 600: uncomment IDP_* below. Never cat.
# Local compose --build: uncomment VITE_* here after copying to .env.
# Public (frontend bake / VITE_):
# VITE_IDP_AUTHORIZE_URL=https://auth.qa.guru/realms/qaguru/protocol/openid-connect/auth
# VITE_IDP_CLIENT_ID=autotests-ai
# Backend POST /api/oauth/idp — copy IDP_CLIENT_SECRET from ~/.config/auth-qa-guru/autotests-ai.env
# IDP_CLIENT_ID=autotests-ai
# IDP_CLIENT_SECRET=
# IDP_TOKEN_URL=https://auth.qa.guru/realms/qaguru/protocol/openid-connect/token
# IDP_USERINFO_URL=https://auth.qa.guru/realms/qaguru/protocol/openid-connect/userinfo
# Dest cloud org create (same Box3 host .env 600 as IDP_*). Empty → POST /api/cloud/repos 503.
# Org autotests-cloud, school token — not a student PAT, not VITE_, not github_oauth.
GITHUB_CLOUD_TOKEN=
